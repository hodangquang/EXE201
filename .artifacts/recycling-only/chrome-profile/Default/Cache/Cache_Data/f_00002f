const __vite__css = "/* ==============================================\r\n   REWEAR — Rains.com exact clone CSS\r\n   Key: parallax hero, pill nav, white grid\r\n   ============================================== */\r\n\r\n.rw {\r\n  background: #F1F1F1;\r\n  color: #10100f;\r\n}\r\n\r\n.rw *,\r\n.rw *::before,\r\n.rw *::after {\r\n  box-sizing: border-box;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n/* ─────────────────────────────────\r\n   NAV & ANNOUNCEMENT\r\n───────────────────────────────── */\r\n.rw-announcement {\r\n  background-color: #40403f;\r\n  color: #f5f5f5;\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  text-align: center;\r\n  padding: 8px 0;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n.rw-announcement-inner {\r\n  display: block;\r\n}\r\n\r\n.rw-nav {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 200;\r\n  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;\r\n}\r\n\r\n.rw-hero {\r\n  margin-top: -70px;\r\n  /* Pull hero under the sticky nav */\r\n}\r\n\r\n.rw-nav--hidden {\r\n  transform: translateY(-100%);\r\n  opacity: 0;\r\n  pointer-events: none;\r\n}\r\n\r\n.rw-nav-inner {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 16px 16px 12px 16px;\r\n  gap: 8px;\r\n}\r\n\r\n.rw-nav-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: nowrap;\r\n  min-width: 0;\r\n}\r\n\r\n.rw-nav-menu {\r\n  display: flex;\r\n  align-items: center;\r\n  min-width: 0;\r\n  overflow-x: auto;\r\n  scrollbar-width: none;\r\n  height: 38px;\r\n  padding: 0 4px;\r\n  border-radius: 9999px;\r\n  background: rgba(200, 200, 200, 0.35);\r\n  backdrop-filter: blur(20px);\r\n  -webkit-backdrop-filter: blur(20px);\r\n  border: 1px solid rgba(255, 255, 255, 0.5);\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);\r\n}\r\n\r\n.rw-nav-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Logo — white pill, like Rains */\r\n.rw-logo-pill {\r\n  display: inline-flex;\r\n  flex: 0 0 auto;\r\n  align-items: center;\r\n  height: 38px;\r\n  padding: 0 16px;\r\n  border-radius: 9999px;\r\n  background: rgba(200, 200, 200, 0.35);\r\n  backdrop-filter: blur(20px);\r\n  -webkit-backdrop-filter: blur(20px);\r\n  border: 1px solid rgba(255, 255, 255, 0.5);\r\n  font-family: 'Barlow Condensed', sans-serif;\r\n  font-size: 12px;\r\n  font-weight: 900;\r\n  letter-spacing: 0.1em;\r\n  text-transform: uppercase;\r\n  color: #10100f;\r\n  text-decoration: none;\r\n  margin-right: 4px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);\r\n  transition: transform 0.2s ease, background 0.2s ease;\r\n}\r\n\r\n.rw-logo-pill:hover {\r\n  background: rgba(255, 255, 255, 0.75);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n/* Nav links — plain text, white */\r\n.rw-nav-lk {\r\n  display: inline-flex;\r\n  flex: 0 0 auto;\r\n  white-space: nowrap;\r\n  align-items: center;\r\n  height: 30px;\r\n  padding: 0 12px;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.02em;\r\n  text-transform: uppercase;\r\n  color: #111;\r\n  text-decoration: none;\r\n  border-radius: 9999px;\r\n  transition: background 0.15s, color 0.15s;\r\n}\r\n\r\n.rw-nav-lk:hover {\r\n  background: rgba(255, 255, 255, 0.45);\r\n  color: #111;\r\n}\r\n\r\n/* Search / Cart — grey pill, like Rains */\r\n.rw-nav-pill {\r\n  font-family: inherit;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  height: 38px;\r\n  padding: 0 14px;\r\n  border-radius: 9999px;\r\n  background: rgba(200, 200, 200, 0.35);\r\n  backdrop-filter: blur(20px);\r\n  -webkit-backdrop-filter: blur(20px);\r\n  border: 1px solid rgba(255, 255, 255, 0.5);\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.02em;\r\n  text-transform: uppercase;\r\n  color: #111;\r\n  border: none;\r\n  cursor: pointer;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.rw-nav-pill:hover {\r\n  background: rgba(255, 255, 255, 0.75);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n/* ─────────────────────────────────\r\n   HERO — STICKY SCRUB PARALLAX (RAINS.COM)\r\n   Outer track is 250vh tall to allow\r\n   full scrolling down the model's body.\r\n   Inner sticky frame is locked 100vh.\r\n───────────────────────────────── */\r\n.rw-hero-track {\r\n  position: relative;\r\n  height: 250vh;\r\n  background: #1a1a1a;\r\n}\r\n\r\n.rw-hero-sticky {\r\n  position: sticky;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  display: flex;\r\n  align-items: flex-end;\r\n}\r\n\r\n.rw-hero-sticky::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.12) 45%, transparent 100%);\r\n  pointer-events: none;\r\n  z-index: 5;\r\n}\r\n\r\n.rw-hero-tall-img {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  min-height: 180vh;\r\n  object-fit: cover;\r\n  object-position: center top;\r\n  will-change: transform;\r\n  pointer-events: none;\r\n  display: block;\r\n}\r\n\r\n/* Hero text block pinned bottom left */\r\n.rw-hero-text-block {\r\n  position: absolute;\r\n  bottom: 40px;\r\n  left: 36px;\r\n  z-index: 10;\r\n  max-width: 90%;\r\n  pointer-events: auto;\r\n}\r\n\r\n.rw-hero-big-title {\r\n  font-family: 'Barlow Condensed', sans-serif;\r\n  font-size: clamp(52px, 8.5vw, 118px);\r\n  font-weight: 900;\r\n  line-height: 1.08;\r\n  letter-spacing: -0.015em;\r\n  color: rgba(230, 230, 230, 0.88);\r\n  margin: 0;\r\n  text-transform: none;\r\n  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.rw-hero-big-title--huge {\r\n  font-size: clamp(60px, 9.8vw, 136px);\r\n}\r\n\r\n.rw-hero-big-sub {\r\n  font-size: clamp(1.2rem, 2.4vw, 2.1rem);\r\n  font-weight: 600;\r\n  color: rgba(220, 220, 220, 0.85);\r\n  margin-top: 14px;\r\n  margin-bottom: 22px;\r\n  letter-spacing: -0.01em;\r\n  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.rw-hero-action-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 11px 24px;\r\n  background: rgba(220, 220, 220, 0.65);\r\n  backdrop-filter: blur(12px);\r\n  -webkit-backdrop-filter: blur(12px);\r\n  border: none;\r\n  border-radius: 9999px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: #10100f;\r\n  text-decoration: none;\r\n  cursor: pointer;\r\n  transition: background 0.2s ease, transform 0.15s ease;\r\n}\r\n\r\n.rw-hero-action-pill:hover {\r\n  background: rgba(245, 245, 245, 0.85);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n/* Secondary banners */\r\n.rw-hero {\r\n  position: relative;\r\n  height: 72vh;\r\n  min-height: 480px;\r\n  overflow: hidden;\r\n  background: #111;\r\n}\r\n\r\n.rw-hero--sm {\r\n  height: 68vh;\r\n}\r\n\r\n.rw-hero--donate {\r\n  height: 65vh;\r\n}\r\n\r\n.rw-hero-img {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 145%;\r\n  object-fit: cover;\r\n  object-position: center top;\r\n  will-change: transform;\r\n  display: block;\r\n}\r\n\r\n.rw-hero-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(to top,\r\n      rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0.12) 50%, transparent 100%);\r\n  z-index: 1;\r\n}\r\n\r\n/* Text block — BOTTOM LEFT, large text over image */\r\n.rw-hero-text {\r\n  position: absolute;\r\n  bottom: 40px;\r\n  left: 40px;\r\n  z-index: 2;\r\n  max-width: 640px;\r\n}\r\n\r\n.rw-hero-text--light .rw-hero-title {\r\n  color: #fff;\r\n}\r\n\r\n.rw-hero-eyebrow {\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: rgba(255, 255, 255, 0.6);\r\n  margin-bottom: 10px;\r\n}\r\n\r\n/* Title — VERY LARGE, like Rains \"Forecast says Rains.\" */\r\n.rw-hero-title {\r\n  font-family: 'Barlow Condensed', sans-serif;\r\n  font-size: clamp(48px, 7.5vw, 120px);\r\n  font-weight: 900;\r\n  line-height: 0.92;\r\n  letter-spacing: -0.02em;\r\n  text-transform: uppercase;\r\n  color: rgba(255, 255, 255, 0.90);\r\n  white-space: pre-line;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.rw-hero-sub {\r\n  font-size: 15px;\r\n  font-weight: 400;\r\n  color: rgba(255, 255, 255, 0.75);\r\n  margin-bottom: 20px;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* CTA pill button — white/grey bg dark text */\r\n.rw-btn-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 40px;\r\n  padding: 0 24px;\r\n  border-radius: 9999px;\r\n  background: rgba(255, 255, 255, 0.88);\r\n  color: #10100f;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.05em;\r\n  text-transform: uppercase;\r\n  border: none;\r\n  cursor: pointer;\r\n  transition: background 0.2s;\r\n}\r\n\r\n.rw-btn-pill:hover {\r\n  background: #fff;\r\n}\r\n\r\n.rw-btn-pill--dark {\r\n  background: #10100f;\r\n  color: #fff;\r\n}\r\n\r\n.rw-btn-pill--dark:hover {\r\n  background: #333;\r\n}\r\n\r\n/* ─────────────────────────────────\r\n   PRODUCT GRID SECTIONS\r\n───────────────────────────────── */\r\n.rw-grid-section {\r\n  background: #F1F1F1;\r\n  padding: 40px 20px 48px;\r\n}\r\n\r\n.rw-grid-section--grey {\r\n  background: #f5f5f4;\r\n}\r\n\r\n.rw-grid-header {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.rw-grid-title {\r\n  font-family: 'Barlow Condensed', sans-serif;\r\n  font-size: 28px;\r\n  font-weight: 900;\r\n  text-transform: uppercase;\r\n  letter-spacing: -0.01em;\r\n}\r\n\r\n.rw-view-all {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.05em;\r\n  text-transform: uppercase;\r\n  color: #555;\r\n  text-decoration: none;\r\n}\r\n\r\n.rw-view-all:hover {\r\n  color: #10100f;\r\n}\r\n\r\n/* Horizontal scrollable product row — exactly like Rains */\r\n.rw-prod-row {\r\n  display: flex;\r\n  gap: 12px;\r\n  align-items: stretch;\r\n  overflow-x: auto;\r\n  scroll-snap-type: x mandatory;\r\n  -webkit-overflow-scrolling: touch;\r\n  scrollbar-width: none;\r\n  position: relative;\r\n}\r\n\r\n.rw-prod-row::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n.rw-prod-row--5 .rw-prod-item {\r\n  flex: 0 0 calc(20% - 10px);\r\n}\r\n\r\n.rw-prod-item {\r\n  flex: 0 0 calc(25% - 9px);\r\n  scroll-snap-align: start;\r\n  cursor: pointer;\r\n}\r\n\r\n.rw-prod-item--desc {\r\n  cursor: pointer;\r\n}\r\n\r\n.rw-prod-photo {\r\n  position: relative;\r\n  aspect-ratio: 0.666;\r\n  overflow: hidden;\r\n  background: #EAEAEA;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.rw-prod-photo--square {\r\n  aspect-ratio: 1/1;\r\n}\r\n\r\n.rw-prod-photo img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n  transition: transform 0.5s ease;\r\n}\r\n\r\n.rw-prod-item:hover .rw-prod-photo img {\r\n  transform: scale(1.04);\r\n}\r\n\r\n.rw-prod-info {\r\n  padding: 0 2px;\r\n}\r\n\r\n.rw-prod-top {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.rw-prod-name {\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: #10100f;\r\n  line-height: 1.3;\r\n}\r\n\r\n.rw-prod-name--bold {\r\n  font-weight: 600;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.rw-prod-price {\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: #10100f;\r\n  white-space: nowrap;\r\n}\r\n\r\n.rw-prod-desc {\r\n  font-size: 12px;\r\n  color: #555554;\r\n  line-height: 1.5;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.rw-prod-shop {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: #10100f;\r\n  text-decoration: underline;\r\n  text-underline-offset: 2px;\r\n}\r\n\r\n/* Color swatches */\r\n.rw-prod-colors {\r\n  display: flex;\r\n  gap: 5px;\r\n  align-items: center;\r\n}\r\n\r\n.rw-color-dot {\r\n  width: 12px;\r\n  height: 12px;\r\n  border-radius: 50%;\r\n  border: 1px solid rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.rw-color-more {\r\n  font-size: 11px;\r\n  color: #999;\r\n  font-weight: 500;