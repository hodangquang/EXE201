n-items: baseline;\n  gap: 10px;\n  margin-bottom: 4px;\n}\n\n/* Text chính: Chữ nhỏ và mảnh (font-weight: 500) */\n.rains-product-name {\n  font-family: 'Inter', sans-serif;\n  font-size: 15px;\n  font-weight: 500;\n  line-height: 1.25;\n  letter-spacing: -0.01em;\n  color: #111111;\n  margin: 0;\n}\n\n.rains-product-price {\n  font-family: 'Inter', sans-serif;\n  font-size: 15px;\n  font-weight: 500;\n  letter-spacing: 0em;\n  color: #111111;\n  white-space: nowrap;\n}\n\n/* Text phụ: Mảnh, nhẹ */\n.rains-product-subtitle {\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  font-weight: 300;\n  line-height: 1.45;\n  color: #4A4A4A;\n  margin: 4px 0 12px 0;\n}\n\n/* Fit Pills (Men's / Women's) — Nhỏ & mảnh */\n.rains-fit-group {\n  display: flex;\n  gap: 6px;\n}\n\n.rains-fit-pill {\n  height: 26px;\n  padding: 0 13px;\n  border-radius: 9999px;\n  border: none;\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  font-weight: 400;\n  cursor: pointer;\n  background: transparent;\n  color: #4A4A4A;\n  transition: all 0.2s ease;\n}\n\n.rains-fit-pill:hover {\n  background: rgba(0, 0, 0, 0.05);\n  color: #111111;\n}\n\n/* Button: Xám than #3A3A39, Button text: Trắng #FFFFFF */\n.rains-fit-pill--active {\n  background: #3A3A39 !important;\n  color: #FFFFFF !important;\n  font-weight: 500;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);\n}\n\n/* ── Module 2: Color Swatches ── */\n.rains-color-header {\n  display: flex;\n  align-items: baseline;\n  gap: 6px;\n  margin-bottom: 10px;\n}\n\n.rains-glass-card--colors .rains-color-header:last-child {\n  margin-bottom: 0;\n}\n\n.rains-label-bold {\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  font-weight: 500;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: #111111;\n}\n\n.rains-label-val {\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  font-weight: 300;\n  color: #4A4A4A;\n}\n\n.rains-color-swatches {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n/* Sw