16, 1, 0.3, 1);\n}\n\n@keyframes drawerSlide {\n  from {\n    transform: translateX(100%);\n  }\n\n  to {\n    transform: translateX(0);\n  }\n}\n\n.rains-drawer-header {\n  padding: 24px 24px 20px 24px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-shrink: 0;\n}\n\n.rains-drawer-title {\n  font-family: 'Inter', sans-serif;\n  font-size: 16px;\n  font-weight: 700;\n  margin: 0;\n  color: #111;\n}\n\n.rains-drawer-header-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.rains-cart-clear-all {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 7px 10px;\n  border: 1px solid #dededc;\n  border-radius: 999px;\n  background: transparent;\n  color: #4a2723;\n  font: 500 12px 'Inter', sans-serif;\n  cursor: pointer;\n  transition: background 0.15s ease, border-color 0.15s ease;\n}\n\n.rains-cart-clear-all:hover:not(:disabled) {\n  background: #f8eeee;\n  border-color: #d8b8b4;\n}\n\n.rains-cart-clear-all:disabled {\n  opacity: 0.55;\n  cursor: not-allowed;\n}\n\n.rains-drawer-close {\n  background: none;\n  border: none;\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  color: #111;\n  transition: opacity 0.15s;\n}\n\n.rains-drawer-close:hover {\n  opacity: 0.6;\n}\n\n/* Cart Items List */\n.rains-cart-items-list {\n  flex: 1;\n  overflow-y: auto;\n  padding: 0 24px;\n}\n\n.rains-cart-selection-bar {\n  display: flex;\n  min-height: 52px;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid #e8e8e8;\n  color: #262626;\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n}\n\n.rains-cart-select-control,\n.rains-cart-item-select {\n  display: inline-flex;\n  align-items: center;\n  cursor: pointer;\n}\n\n.rains-cart-select-control {\n  min-height: 44px;\n  gap: 10px;\n  font-weight: 600;\n}\n\n.rains-cart-selected-count {\n  color: #777;\n  font-size: 12px;\n}\n\n.rains-cart-select-control input,\n.rains-cart-item-select input {\n  width: 18px;\n  height: 18px;\n  margin: 0;\n  accent-color: #10100f;\n  cursor: pointer;\n}\n\n.rains-cart-select-control input:focus-visible,\n.rains-cart-item-select input:focus-visible {\n  outline: 2px solid #a69f2a;\n  outline-offset: 3px;\n}\n\n.rains-cart-select-control input:disabled,\n.rains-cart-item-select input:disabled {\n  cursor: not-allowed;\n}\n\n.rains-cart-clear-confirm {\n  margin: 0 0 14px;\n  padding: 14px;\n  border: 1px solid #e5cfcc;\n  border-radius: 12px;\n  background: #fbf5f4;\n  color: #332321;\n  font-family: 'Inter', sans-serif;\n}\n\n.rains-cart-clear-confirm p {\n  margin: 0 0 12px;\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.rains-cart-clear-confirm > div {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.rains-cart-clear-confirm button {\n  min-height: 34px;\n  padding: 0 12px;\n  border: 1px solid #d8d3d1;\n  border-radius: 999px;\n  background: #fff;\n  color: #24201f;\n  font: 500 12px 'Inter', sans-serif;\n  cursor: pointer;\n}\n\n.rains-cart-clear-confirm button:last-child {\n  border-color: #3a2927;\n  background: #3a2927;\n  color: #fff;\n}\n\n.rains-cart-clear-confirm button:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.rains-cart-confirm-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 220;\n  display: grid;\n  place-items: center;\n  padding: 20px;\n  background: rgba(16, 16, 15, 0.48);\n  animation: modalFadeIn 0.16s ease-out;\n}\n\n.rains-cart-confirm-dialog {\n  width: min(100%, 420px);\n  padding: 28px;\n  border: 1px solid rgba(16, 16, 15, 0.08);\n  border-radius: 20px;\n  background: #fff;\n  color: #10100f;\n  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);\n  font-family: 'Inter', sans-serif;\n  animation: cartConfirmPop 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);\n}\n\n.rains-cart-confirm-icon {\n  display: grid;\n  width: 44px;\n  height: 44px;\n  margin-bottom: 18px;\n  place-items: center;\n  border-radius: 50%;\n  background: #fffb85;\n  color: #10100f;\n}\n\n.rains-cart-confirm-dialog h4 {\n  margin: 0 0 9px;\n  font-size: 20px;\n  line-height: 1.25;\n  font-weight: 700;\n}\n\n.rains-cart-confirm-dialog p {\n  margin: 0;\n  color: #666;\n  font-size: 14px;\n  line-height: 1.6;\n  overflow-wrap: anywhere;\n}\n\n.rains-cart-confirm-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 10px;\n  margin-top: 24px;\n}\n\n.rains-cart-confirm-actions button {\n  min-height: 44px;\n  padding: 0 18px;\n  border: 1px solid #d9d9d9;\n  border-radius: 999px;\n  background: #fff;\n  color: #10100f;\n  font: 600 13px 'Inter', sans-serif;\n  cursor: pointer;\n  transition: background-color 0.15s ease, color 0.15s ease, opacity 0.15s ease;\n}\n\n.rains-cart-confirm-actions .rains-cart-confirm-delete {\n  border-color: #10100f;\n  background: #10100f;\n  color: #fff;\n}\n\n.rains-cart-confirm-actions .rains-cart-confirm-cancel:hover {\n  background: #f4f4f2;\n}\n\n.rains-cart-confirm-actions .rains-cart-confirm-delete:hover {\n  background: #383836;\n}\n\n.rains-cart-confirm-actions button:focus-visible {\n  outline: 3px solid #a69f2a;\n  outline-offset: 3px;\n}\n\n.rains-cart-confirm-actions button:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n@keyframes cartConfirmPop {\n  from { opacity: 0; transform: translateY(8px) scale(0.98); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@media (max-width: 480px) {\n  .rains-cart-confirm-dialog {\n    padding: 24px;\n    border-radius: 18px;\n  }\n\n  .rains-cart-confirm-actions {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .rains-cart-confirm-overlay,\n  .rains-cart-confirm-dialog {\n    animation: none;\n  }\n}\n\n.rains-cart-row {\n  display: flex;\n  gap: 16px;\n  padding: 20px 0;\n  border-top: 1px solid #e8e8e8;\n}\n\n.rains-cart-item-leading {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: 10px;\n}\n\n.rains-cart-item-select {\n  width: 24px;\n  min-height: 44px;\n  justify-content: center;\n}\n\n.rains-cart-row:first-child {\n  border-top: 1px solid #e8e8e8;\n}\n\n.rains-cart-thumb-wrap {\n  width: 100px;\n  height: 130px;\n  flex-shrink: 0;\n  background: #f5f5f5;\n  overflow: hidden;\n  display: grid;\n  place-items: center;\n  color: #858585;\n}\n\n.rains-cart-thumb {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.rains-cart-details {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.rains-cart-item-name {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  margin: 0 0 4px 0;\n  color: #111;\n}\n\n.rains-cart-item-variant {\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n  font-weight: 400;\n  color: #555;\n  margin: 0 0 4px 0;\n}\n\n.rains-cart-item-price {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  color: #111;\n  margin: 0 0 12px 0;\n}\n\n.rains-cart-item-actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: auto;\n}\n\n/* Quantity Control — matches Rains.com (- 1 +) */\n.rains-qty-control {\n  display: inline-flex;\n  align-items: center;\n  border-radius: 9999px;\n  overflow: hidden;\n  background: #f0f0f0;\n}\n\n.rains-qty-btn {\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #e5e5e5;\n  border: none;\n  cursor: pointer;\n  color: #111;\n  transition: background 0.15s;\n}\n\n.rains-qty-btn:hover {\n  background: #d5d5d5;\n}\n\n.rains-qty-val {\n  width: 36px;\n  text-align: center;\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 600;\n  color: #111;\n}\n\n.rains-cart-remove {\n  background: none;\n  border: none;\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n  font-weight: 400;\n  color: #111;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  cursor: pointer;\n  padding: 0;\n}\n\n.rains-cart-remove:hover {\n  color: #888;\n}\n\n/* Delivery Row */\n.rains-cart-delivery {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 20px 0;\n  border-top: 1px solid #e8e8e8;\n}\n\n.rains-cart-delivery-label {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  color: #111;\n}\n\n.rains-cart-delivery-val {\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n  font-weight: 400;\n  color: #555;\n}\n\n/* Upsell Section */\n.rains-cart-upsell {\n  padding: 20px 0 24px 0;\n  border-top: 1px solid #e8e8e8;\n}\n\n.rains-cart-upsell-title {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  color: #111;\n  margin: 0 0 16px 0;\n}\n\n.rains-cart-upsell-item {\n  display: flex;\n  gap: 16px;\n}\n\n.rains-cart-upsell-thumb-wrap {\n  width: 100px;\n  height: 120px;\n  flex-shrink: 0;\n  background: #f5f5f5;\n  overflow: hidden;\n}\n\n.rains-cart-upsell-thumb {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.rains-cart-upsell-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.rains-cart-upsell-info h5 {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  margin: 0 0 4px 0;\n  color: #111;\n}\n\n.rains-cart-upsell-meta {\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n  color: #555;\n  margin: 0 0 6px 0;\n}\n\n.rains-cart-upsell-prices {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  margin: 0 0 12px 0;\n}\n\n.rains-price-sale {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  color: #111;\n}\n\n.rains-price-orig {\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n  font-weight: 400;\n  color: #999;\n  text-decoration: line-through;\n}\n\n.rains-cart-upsell-btn {\n  width: 100%;\n  height: 42px;\n  border-radius: 9999px;\n  background: #ffffff;\n  color: #111;\n  border: 1px solid #111;\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.rains-cart-upsell-btn:hover {\n  background: #111;\n  color: #fff;\n}\n\n/* Cart Footer — sticky bottom */\n.rains-drawer-footer {\n  padding: 20px 24px;\n  border-top: 1px solid #e8e8e8;\n  background: #ffffff;\n  flex-shrink: 0;\n}\n\n.rains-subtotal-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-family: 'Inter', sans-serif;\n  font-size: 15px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 16px;\n}\n\n.rains-footer-actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.rains-view-cart-link {\n  flex: 1;\n  background: none;\n  border: none;\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 400;\n  color: #111;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  cursor: pointer;\n  padding: 12px 0;\n  text-align: center;\n}\n\n.rains-view-cart-link:hover {\n  color: #555;\n}\n\n.rains-checkout-btn {\n  flex: 1;\n  height: 48px;\n  border-radius: 9999px;\n  background: #3A3A39;\n  color: #fff;\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 600;\n  border: none;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.rains-checkout-btn:hover {\n  background: #111;\n}\n\n.rains-checkout-btn:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n\n/* ──────────────────────────────────────────────────────────────\n   8. FULLSCREEN LIGHTBOX\n   ────────────────────────────────────────────────────────────── */\n.rains-lightbox-backdrop {\n  width: 100%;\n  height: 100dvh;\n  max-width: none;\n  max-height: none;\n  margin: 0;\n  border: 0;\n  position: fixed;\n  inset: 0;\n  z-index: 300;\n  background: rgba(18, 18, 18, 0.94);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  animation: modalFadeIn 0.2s ease;\n}\n\n.rains-pdp-state { min-height: 65vh; display: grid; align-content: center; justify-items: center; gap: 20px; padding: 40px 20px; text-align: center; }\n.rains-pdp-state h1 { font-size: clamp(26px, 5vw, 40px); line-height: 1.25; }\n.rains-pdp-state a { color: inherit; padding: 12px 20px; border: 1px solid; border-radius: 999px; }\n.rains-pdp .rains-rec-card { color: inherit; text-decoration: none; min-width: 0; }\n.rains-pdp .rains-conveyor-track:focus-within { animation-play-state: paused; }\n.rains-pdp .rains-gallery-pause { position: absolute; z-index: 20; bottom: 24px; left: 20px; min-height: 44px; padding: 10px 16px; border: 1px solid #ddd; border-radius: 999px; background: #fff; color: #10100f; cursor: pointer; }\n\n.rains-lightbox-close {\n  position: absolute;\n  top: 24px;\n  right: 28px;\n  background: rgba(255, 255, 255, 0.15);\n  border: none;\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  color: #ffffff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.rains-lightbox-close:hover {\n  background: rgba(255, 255, 255, 0.3);\n}\n\n.rains-lightbox-img {\n  max-width: 90vw;\n  max-height: 90vh;\n  object-fit: contain;\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\n  animation: cardSlideUp 0.25s ease-out;\n}\n\n/* ──────────────────────────────────────────────────────────────\n   9. RESPONSIVE DESIGN\n   ────────────────────────────────────────────────────────────── */\n@media (max-width: 1024px) {\n  .rains-nav-menu {\n    display: none;\n  }\n\n  .rains-nav-about-mobile {\n    display: inline-flex;\n    pointer-events: auto;\n  }\n\n  .rains-floating-widget {\n    right: 16px;\n    bottom: 16px;\n    width: 330px;\n  }\n}\n\n@media (max-width: 768px) {\n  .rains-pdp {\n    overflow-y: auto;\n    overflow-x: hidden;\n    height: auto;\n    min-height: 100vh;\n  }\n\n  .rains-hero-viewport {\n    height: auto;\n    min-height: 100vh;\n  }\n\n  .rains-conveyor-viewport {\n    position: relative;\n    height: 65vh;\n    width: 100%;\n  }\n\n  .rains-conveyor-item {\n    height: 60vh;\n  }\n\n  .rains-floating-widget {\n    position: relative;\n    right: auto;\n    bottom: auto;\n    width: 100%;\n    max-width: 100%;\n    padding: 16px;\n    box-sizing: border-box;\n  }\n\n  .rains-conveyor-controls {\n    bottom: 12px;\n    left: 12px;\n  }\n\n  .rains-conveyor-hint {\n    display: none;\n  }\n}\n\n.rains-warranty-banner {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 16px;\n  background-color: #F8F8F8;\n  padding: 16px;\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  font-weight: 500;\n  color: #111111;\n  letter-spacing: -0.01em;\n}\n\n/* ──────────────────────────────────────────────────────────────\n   7. TWO-COLUMN PRODUCT DETAIL SECTION\n   \"ở dưới 1 bên là hình 1 bên là như hình\"\n   Matches Screenshots 1, 2, 3:\n   - Left: Product detail image\n   - Right: Breadcrumbs, Description & Expandable Accordions\n   ────────────────────────────────────────────────────────────── */\n.rains-detail-section {\n  position: relative;\n  width: 100%;\n  background: #FFFFFF;\n  border-top: 1px solid #EBEBEB;\n  padding: 0;\n  box-sizing: border-box;\n}\n\n.rains-detail-container {\n  width: 100%;\n  max-width: 100%;\n  margin: 0;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0;\n  align-items: stretch;\n}\n\n/* ── Left Column: Product Image (Dài bằng 100% form bên cạnh) ── */\n.rains-detail-left {\n  position: relative;\n  display: flex;\n  width: 100%;\n  height: 100%;\n  align-self: stretch;\n}\n\n.rains-detail-img-card {\n  width: 100%;\n  height: 100%;\n  min-height: 100%;\n  background: #EAEAE8;\n  border-radius: 0;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n}\n\n.rains-detail-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center top;\n  display: block;\n  transition: transform 0.4s ease;\n}\n\n.rains-detail-img-card:hover .rains-detail-img {\n  transform: scale(1.015);\n}\n\n.rains-detail-view-switches {\n  max-width: calc(100% - 24px);\n  width: max-content;\n  flex-wrap: wrap;\n  justify-content: center;\n  position: absolute;\n  bottom: 16px;\n  left: 50%;\n  transform: translateX(-50%);\n  display: flex;\n  gap: 6px;\n  background: rgba(255, 255, 255, 0.85);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.7);\n  padding: 4px 6px;\n  border-radius: 9999px;\n  z-index: 10;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);\n}\n\n.rains-detail-switch-btn {\n  min-height: 44px;\n  white-space: nowrap;\n  border: none;\n  background: transparent;\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  font-weight: 500;\n  color: #4A4A4A;\n  padding: 4px 12px;\n  border-radius: 9999px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.rains-detail-switch-btn:hover {\n  color: #111111;\n}\n\n.rains-detail-switch-btn--active {\n  background: #3A3A39;\n  color: #FFFFFF;\n}\n\n@media (min-width: 1024px) {\n  .rains-detail-view-switches { top: 104px; bottom: auto; }\n}\n\n/* ── Right Column: Breadcrumbs & Accordions (Screenshots 2 & 3) ── */\n.rains-detail-right {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  max-width: 100%;\n  padding: 60px 24px 120px 24px;\n  font-family: 'Inter', sans-serif;\n  box-sizing: border-box;\n}\n\n/* Breadcrumb Navigation */\n.rains-detail-breadcrumb {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  width: 100%;\n  max-width: 460px;\n  padding-bottom: 24px;\n  margin-bottom: 8px;\n  border-bottom: 1px solid #EEEEEE;\n  font-family: 'Inter', sans-serif;\n  font-size: 13px;\n  font-weight: 400;\n  color: #666666;\n}\n\n.rains-bc-link {\n  color: #666666;\n  text-decoration: none;\n  transition: color 0.15s ease;\n}\n\n.rains-bc-link:hover {\n  color: #111111;\n}\n\n.rains-bc-current {\n  color: #111111;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n  font-weight: 500;\n}\n\n/* Accordion Group & Items */\n.rains-accordion-group {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  max-width: 460px;\n}\n\n.rains-accordion-item {\n  border-bottom: 1px solid #EEEEEE;\n}\n\n.rains-accordion-header {\n  width: 100%;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 22px 0;\n  background: transparent;\n  border: none;\n  cursor: pointer;\n  text-align: left;\n  font-family: 'Inter', sans-serif;\n  transition: opacity 0.15s ease;\n}\n\n.rains-accordion-header:hover {\n  opacity: 0.75;\n}\n\n.rains-acc-title-wrap {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.rains-acc-title {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  color: #000000;\n  letter-spacing: -0.01em;\n  margin: 0;\n}\n\n.rains-acc-title--main {\n  font-size: 15px;\n  font-weight: 700;\n  color: #000000;\n}\n\n.rains-stars {\n  color: #000000;\n  font-size: 14.5px;\n  letter-spacing: 2px;\n}\n\n.rains-acc-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #000000;\n  width: 22px;\n  height: 22px;\n  flex-shrink: 0;\n}\n\n/* Accordion Content Body */\n.rains-accordion-content {\n  padding: 0 0 26px 0;\n  animation: rainsAccSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  font-family: 'Inter', sans-serif;\n}\n\n@keyframes rainsAccSlide {\n  from {\n    opacity: 0;\n    transform: translateY(-4px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.rains-accordion-content p {\n  font-family: 'Inter', sans-serif;\n  font-size: 12.5px;\n  line-height: 1.68;\n  color: #111111;\n  margin: 0 0 16px 0;\n  font-weight: 400;\n}\n\n.rains-accordion-content p:last-of-type {\n  margin-bottom: 16px;\n}\n\n.rains-sku-line {\n  font-family: 'Inter', sans-serif;\n  font-size: 12px;\n  font-weight: 400;\n  color: #666666;\n  letter-spacing: 0.02em;\n  margin-top: 22px;\n}\n\n/* Bullet list styles */\n.rains-bullet-list {\n  margin: 0;\n  padding-left: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  font-family: 'Inter', sans-serif;\n  font-size: 12.5px;\n  line-height: 1.6;\n  color: #222222;\n}\n\n.rains-bullet-list strong {\n  color: #000000;\n  font-weight: 600;\n}\n\n/* Spec grid */\n.rains-spec-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.rains-spec-row {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding-bottom: 10px;\n  border-bottom: 1px dashed #E5E5E5;\n}\n\n.rains-spec-label {\n  font-size: 11.5px;\n  font-weight: 700;\n  color: #666666;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.rains-spec-val {\n  font-size: 13.5px;\n  color: #111111;\n}\n\n/* Promo bundle box */\n.rains-promo-bundle-box {\n  background: #F8F8F7;\n  border: 1px solid #E5E5E3;\n  border-radius: 8px;\n  padding: 16px 20px;\n  margin-top: 6px;\n}\n\n.rains-promo-tag {\n  display: inline-block;\n  background: #3A3A39;\n  color: #FFFFFF;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  padding: 3px 8px;\n  border-radius: 4px;\n  margin-bottom: 8px;\n}\n\n.rains-promo-text {\n  font-size: 13.5px !important;\n  color: #333333 !important;\n  margin: 0 !important;\n  line-height: 1.55 !important;\n}\n\n/* Inline link */\n.rains-inline-link {\n  background: none;\n  border: none;\n  color: #111111;\n  font-weight: 600;\n  font-size: 13.5px;\n  text-decoration: underline;\n  cursor: pointer;\n  padding: 0;\n  margin-top: 10px;\n  display: inline-block;\n  font-family: 'Inter', sans-serif;\n}\n\n.rains-inline-link:hover {\n  opacity: 0.75;\n}\n\n/* Review card */\n.rains-review-card {\n  background: #FAFAF9;\n  border: 1px solid #EAEAEA;\n  border-radius: 8px;\n  padding: 18px 20px;\n}\n\n.rains-review-head {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin-bottom: 8px;\n}\n\n.rains-review-stars {\n  color: #000000;\n  font-size: 14px;\n  letter-spacing: 2px;\n}\n\n.rains-review-author {\n  font-weight: 600;\n  font-size: 13.5px;\n  color: #111111;\n}\n\n.rains-review-date {\n  font-size: 12px;\n  color: #777777;\n}\n\n.rains-review-title {\n  font-size: 14.5px;\n  font-weight: 700;\n  color: #111111;\n  margin: 0 0 6px 0;\n}\n\n.rains-review-text {\n  font-size: 13.5px !important;\n  color: #444444 !important;\n  line-height: 1.55 !important;\n  margin: 0 !important;\n  font-style: italic;\n}\n\n/* Responsive adjustments for 2-column detail section */\n@media (max-width: 991px) {\n  .rains-detail-section {\n    padding: 0;\n  }\n\n  .rains-detail-container {\n    grid-template-columns: 1fr;\n    gap: 0;\n  }\n\n  .rains-detail-img-card {\n    position: relative;\n    top: 0;\n    width: 100%;\n    min-height: 520px;\n  }\n\n  .rains-detail-right {\n    max-width: 100%;\n    padding: 40px 24px 80px 24px;\n  }\n}\n\n/* ──────────────────────────────────────────────────────────────\n   8. YOU MAY ALSO LIKE SECTION — TO À FULL NGANG HẾT MÀN HÌNH\n   Matches User Screenshot:\n   - Full edge-to-edge 100% viewport width\n   - Large tall cards touching each other\n   - Exact info: Title, price, color dots, sizes (XS S M L XL XXL)\n   ────────────────────────────────────────────────────────────── */\n.rains-rec-section {\n  position: relative;\n  width: 100%;\n  background: #FFFFFF;\n  padding: 0;\n  margin-bottom: 80px;\n  box-sizing: border-box;\n  overflow: hidden;\n}\n\n.rains-rec-header {\n  display: block;\n  padding: 60px 14px 24px 14px;\n}\n\n.rains-rec-title {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  font-weight: 700;\n  color: #111111;\n  letter-spacing: -0.01em;\n  margin: 0;\n}\n\n.rains-rec-slider-wrap {\n  position: relative;\n  width: 100%;\n  padding: 0;\n  margin: 0;\n}\n\n.rains-rec-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1px;\n  background: #EAEAEA;\n  /* subtle 1px divider line between full-bleed items */\n  width: 100%;\n  box-sizing: border-box;\n  border-bottom: 1px solid #EA