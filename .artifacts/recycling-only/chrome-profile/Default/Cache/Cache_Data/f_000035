ter;\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.15s ease;\n}\n\n.rains-size-btn:hover {\n  background: rgba(0, 0, 0, 0.05);\n}\n\n/* Button: Xám than #3A3A39, Button text: Trắng #FFFFFF */\n.rains-size-btn--active {\n  background: #3A3A39 !important;\n  color: #FFFFFF !important;\n  font-weight: 500;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);\n}\n\n/* ── Module 4: Add to Cart CTA ── */\n.rains-glass-card--action {\n  padding: 13px 16px;\n}\n\n/* Button: Xám than #3A3A39, Button text: Trắng #FFFFFF */\n.rains-add-to-cart-btn {\n  width: 100%;\n  height: 44px;\n  border-radius: 9999px;\n  background: #3A3A39;\n  color: #FFFFFF;\n  border: 1px solid #3A3A39;\n  font-family: 'Inter', sans-serif;\n  font-size: 11.5px;\n  font-weight: 500;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  cursor: pointer;\n  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.10);\n  transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.rains-add-to-cart-btn:hover {\n  background: #252524;\n  border-color: #252524;\n  transform: translateY(-1px);\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);\n}\n\n.rains-add-to-cart-btn:active {\n  transform: translateY(1px);\n}\n\n.rains-add-to-cart-btn--loading {\n  background: #5A5A58 !important;\n  border-color: #5A5A58 !important;\n  opacity: 0.85;\n}\n\n.rains-add-to-cart-btn--success {\n  background: #2D5A3C !important;\n  border-color: #2D5A3C !important;\n}\n\n.rains-btn-content {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n}\n\n/* Text phụ: Xám đậm #4A4A4A */\n.rains-shipping-guarantee {\n  text-align: center;\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  font-weight: 400;\n  color: #555555;\n  margin: 10px 0 6px 0;\n}\n\n.rains-shipping-guarantee strong {\n  font-weight: 600;\n  color: #111111;\n}\n\n.rains-instore-status {\n  display: flex;\