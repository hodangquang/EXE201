 100%;\n  height: 100%;\n  background: transparent;\n  border-radius: 0;\n  overflow: visible;\n  cursor: grab;\n  box-shadow: none;\n}\n\n.rains-img-card:active {\n  cursor: grabbing;\n}\n\n.rains-conveyor-img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center;\n  background: transparent;\n  display: block;\n  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.rains-img-card:hover .rains-conveyor-img {\n  transform: scale(1.02);\n}\n\n/* Zoom hint button */\n.rains-zoom-badge {\n  position: absolute;\n  top: 18px;\n  right: 18px;\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.7);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  border: 1px solid rgba(255, 255, 255, 0.6);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #111;\n  opacity: 0;\n  transform: scale(0.85);\n  transition: all 0.25s ease;\n  cursor: pointer;\n  z-index: 5;\n}\n\n.rains-img-card:hover .rains-zoom-badge {\n  opacity: 1;\n  transform: scale(1);\n}\n\n/* ──────────────────────────────────────────────────────────────\n   3. INTERACTIVE HOTSPOT '+' ON MODEL'S CHEST\n   (Matches screenshot 1)\n   ────────────────────────────────────────────────────────────── */\n.rains-hotspot-wrapper {\n  position: absolute;\n  z-index: 20;\n  transform: translate(-50%, -50%);\n}\n\n.rains-hotspot-btn {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.45);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.75);\n  color: #10100f;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);\n  transition: transform 0.2s ease, background 0.2s ease;\n  position: relative;\n}\n\n.rains-hotspot-btn:hover,\n.rains-hotspot-btn--active {\n  background: rgba(255, 255, 255, 0.95);\n  transform: scale(1.12);\n}\n\n.rains-hotspot-ping {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  border: 1.5px solid rgba(255, 255, 255, 0.8);\n  animation: hotspotPulse 2.2s cubic-bezier(0.24, 0, 0.38, 1) infinite;\n  pointer-events: none;\n}\n\n@keyframes hotspotPulse {\n  0% {\n    transform: scale(0.9);\n    opacity: 0.9;\n  }\n\n  70% {\n    transform: scale(1.8);\n    opacity: 0;\n  }\n\n  100% {\n    transform: scale(1.9);\n    opacity: 0;\n  }\n}\n\n.rains-hotspot-tooltip {\n  position: absolute;\n  top: 48px;\n  left: 0;\n  width: 250px;\n  background: rgba(255, 255, 255, 0.96);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  padding: 14px;\n  border-radius: 12px;\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);\n  border: 1px solid rgba(0, 0, 0, 0.06);\n  animation: tooltipFadeIn 0.2s ease-out;\n  z-index: 30;\n}\n\n@keyframes tooltipFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.rains-hotspot-tt-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 6px;\n}\n\n.rains-hotspot-tt-title {\n  font-size: 13px;\n  font-weight: 700;\n  color: #111;\n}\n\n.rains-hotspot-tt-badge {\n  font-size: 12px;\n  font-weight: 700;\n  color: #111;\n}\n\n.rains-hotspot-tt-desc {\n  font-size: 11.5px;\n  line-height: 1.45;\n  color: #555;\n  margin-bottom: 8px;\n}\n\n.rains-hotspot-tt-footer {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.rains-hotspot-tt-tag {\n  font-size: 9.5px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  background: #f0f0f0;\n  padding: 3px 6px;\n  border-radius: 4px;\n  color: #333;\n}\n\n/* ──────────────────────────────────────────────────────────────\n   4. CONVEYOR HUD CONTROLS (Bottom Left)\n   ────────────────────────────────────────────────────────────── */\n.rains-conveyor-controls {\n  position: absolute;\n  bottom: 22px;\n  left: 22px;\n  z-index: 40;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.rains-ctrl-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  height: 28px;\n  padding: 0 12px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, 0.85);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1px solid rgba(255, 255, 255, 0.6);\n  font-size: 11px;\n  font-weight: 600;\n  color: #222;\n  cursor: pointer;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n  transition: all 0.2s ease;\n}\n\n.rains-ctrl-pill:hover {\n  background: #fff;\n  transform: translateY(-1px);\n}\n\n.rains-ctrl-arrows {\n  display: flex;\n  align-items: center;\n  background: rgba(255, 255, 255, 0.85);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border-radius: 9999px;\n  height: 28px;\n  padding: 0 2px;\n  border: 1px solid rgba(255, 255, 255, 0.6);\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n}\n\n.rains-ctrl-arrow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 26px;\n  height: 24px;\n  border: none;\n  background: transparent;\n  color: #222;\n  border-radius: 9999px;\n  cursor: pointer;\n  transition: background 0.15s ease;\n}\n\n.rains-ctrl-arrow:hover {\n  background: rgba(0, 0, 0, 0.06);\n}\n\n.rains-conveyor-hint {\n  font-size: 11px;\n  font-weight: 500;\n  color: #666;\n  margin-left: 6px;\n  background: rgba(255, 255, 255, 0.65);\n  backdrop-filter: blur(10px);\n  padding: 4px 10px;\n  border-radius: 9999px;\n}\n\n/* ──────────────────────────────────────────────────────────────\n   5. FLOATING PRODUCT SELECTION WIDGET CARD\n   Exact match to Screenshots 1 & 2:\n   Frosted Glassmorphic Stack on Right Side\n   ────────────────────────────────────────────────────────────── */\n.rains-floating-widget {\n  position: absolute;\n  right: 26px;\n  top: 50%;\n  transform: translateY(-50%);\n  z-index: 50;\n  width: 370px;\n  max-width: calc(100vw - 32px);\n  max-height: calc(